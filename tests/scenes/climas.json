{
 "cfg": {
  "settings": {
   "fx": true
  },
  "node": {
   "modifier": "none"
  }
 },
 "viewports": [
  "mobile"
 ],
 "themes": [
  "walnut",
  "pixelada"
 ],
 "steps": [
  {
   "eval": "bench.view.setWeather('rain'); 1"
  },
  {
   "wait": 300
  },
  {
   "expect": {
    "eval": "document.querySelector('.screen').dataset.weather === 'rain' && getComputedStyle(document.querySelector('.screen'), '::before').backgroundImage.includes('svg')"
   }
  },
  {
   "eval": "bench.view.setWeather('snow'); 1"
  },
